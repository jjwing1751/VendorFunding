{
  "name": "fundline",
  "version": "0.1.0",
  "private": true,
  "description": "Fundline: retailer-side vendor funding management (prototype)",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "render-start": "tsx scripts/migrate.ts && tsx scripts/seed.ts && next start -p ${PORT:-3000}",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --conditions=react-server --test tests/*.test.ts",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "test:e2e:demo": "node tests/e2e/demo.mjs",
    "test:e2e:funding": "node tests/e2e/funding.mjs"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "drizzle-orm": "0.45.3",
    "jszip": "^3.10.1",
    "next": "15.5.27",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "^0.0.1",
    "tsx": "4.23.15",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "drizzle-kit": "0.31.11",
    "typescript": "5.9.3"
  }
}
